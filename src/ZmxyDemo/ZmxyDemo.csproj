<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZmxyDemo</AssemblyName>
    <Product>造梦工坊</Product>
    <Title>造梦工坊</Title>
    <Description>造梦西游 3 游戏工作台</Description>
    <Version>0.6.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>ZmxyDemo.Program</StartupObject>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <CefSharpAnyCpuSupport>false</CefSharpAnyCpuSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms" Version="84.4.10" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Security" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../test-page.html" Link="test-page.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
